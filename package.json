{
  "type": "module",
  "name": "kiro-proxy",
  "version": "1.0.0",
  "description": "Kiro AI Proxy — OpenAI-compatible proxy with premium UI",
  "private": true,
  "scripts": {
    "dev": "node src/start-next.js dev",
    "build": "next build",
    "start": "node src/start-next.js start",
    "gateway": "node src/gateway-server.js",
    "gateway:refresh-models": "node src/jobs/refresh-gateway-models.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "test:gateway": "node --test tests/gateway.test.js",
    "coverage": "node --test --experimental-test-coverage tests/gateway.test.js",
    "coverage:all": "node --test --test-concurrency=1 --experimental-test-coverage tests/**/*.test.js",
    "coverage:model-import": "node --test --experimental-test-coverage --test-name-pattern=\"model catalog import|model refresh parser\" tests/gateway.test.js"
  },
  "dependencies": {
    "next": "^16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "material-symbols": "^0.44.6",
    "uuid": "^13.0.0",
    "undici": "^7.19.2",
    "jose": "^6.1.3",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "tailwindcss": "^4",
    "postcss": "^8.5.6"
  }
}
